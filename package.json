{
  "name": "mangacount",
  "version": "2.2.5",
  "description": "MangaCount is a local-first desktop manga collection manager (Electron + SQLite) with a React renderer and a shared recommendation engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "MANGACOUNT_LANG=es node --test \"electron/**/*.test.js\"",
    "test:coverage": "MANGACOUNT_LANG=es node --test --experimental-test-coverage --test-coverage-exclude=\"mangacount.client/**\" --test-coverage-exclude=\"**/*.test.js\" --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"electron/**/*.test.js\"",
    "lint:renderer": "npm --prefix mangacount.client run lint",
    "test:renderer": "npm --prefix mangacount.client run test -- --run",
    "test:renderer:coverage": "npm --prefix mangacount.client run test -- --run --coverage",
    "dev": "npm --prefix mangacount.client run dev",
    "build:renderer": "npm --prefix mangacount.client run build",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux deb AppImage --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --publish never",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "release:sync": "node scripts/sync-pkgbuild-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lubonch/MangaCount.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Lubonch/MangaCount/issues"
  },
  "homepage": "https://github.com/Lubonch/MangaCount#readme",
  "author": "MangaCount",
  "main": "electron/main/index.js",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "pg": "^8.23.1"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.mangacount.app",
    "productName": "MangaCount",
    "publish": [
      {
        "provider": "github",
        "owner": "Lubonch",
        "repo": "MangaCount"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "shared/recommendations/**/*",
      "mangacount.client/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "MangaCount"
    }
  }
}
